# ThinkTank environment. Copy this file to .env, or let ./install.sh create it.
# .env is read by docker-compose.yml, by install.sh and by the scripts/ helpers.
# Never commit .env - it holds the API key.

# Where the Qdrant instance listens. The whole stack is local by default:
# no VPN, no remote host, no external embedding service.
#
# This is the address install.sh and the MCP server connect TO. Its port must
# match QDRANT_HOST_PORT below whenever that address is local; install.sh checks
# the two against each other and refuses to start rather than bringing up a
# container on one port and then talking to another.
QDRANT_URL=http://localhost:6333

# The HOST port docker-compose.yml publishes Qdrant's REST API on, and the one
# beside it for gRPC. Inside the container Qdrant always listens on 6333/6334 -
# these two move only the outside.
#
# Change them when 6333 is already taken. That is not a rare case here: 6333 is
# the Qdrant default port, and someone installing a RAG engineering kit is
# unusually likely to have a Qdrant of their own on it already. `docker compose
# up -d` would take the port, leave the previous container stopped, and point
# every MCP server already aimed at localhost:6333 at a new, empty instance with
# a different API key. The old data stays on disk, but the memory is gone from
# the session and nothing says why.
#
# Change QDRANT_URL to the same port in the same edit:
#
#   QDRANT_HOST_PORT=6343
#   QDRANT_URL=http://localhost:6343
#
# install.sh does not derive one from the other. QDRANT_URL is a full address
# and may legitimately point at a Qdrant this compose file does not manage, so
# rewriting its port from a compose setting would silently redirect a
# deliberate choice. It compares them instead, and names both values when they
# disagree.
QDRANT_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334

# API key for the Qdrant instance. Leave this blank in .env.example.
# install.sh generates a random value on first run (openssl rand -hex 24, with a
# /dev/urandom fallback) and writes it into .env. If .env already exists, the
# key is left alone - rotating it would lock the running container out of its
# own storage until it is restarted.
QDRANT_API_KEY=

# The single collection every ThinkTank memory is written to and read from.
COLLECTION_NAME=thinktank-memory

# Embedding model. mcp-server-qdrant computes the vectors client-side via
# fastembed, so this model determines the collection's vector size (384) and
# distance metric (Cosine). Changing it after the collection exists means
# creating a new collection and re-storing the memories - never editing the
# model on a collection that already holds points.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
