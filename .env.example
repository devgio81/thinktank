# ThinkTank environment. Copy this file to .env, or let ./install.sh create it.
# .env is read by docker-compose.yml, by install.sh and by the scripts/ helpers.
# Never commit .env - it holds the API key.

# Where the Qdrant instance listens. The whole stack is local by default:
# no VPN, no remote host, no external embedding service.
QDRANT_URL=http://localhost:6333

# API key for the Qdrant instance. Leave this blank in .env.example.
# install.sh generates a random value on first run (openssl rand -hex 24, with a
# /dev/urandom fallback) and writes it into .env. If .env already exists, the
# key is left alone - rotating it would lock the running container out of its
# own storage until it is restarted.
QDRANT_API_KEY=

# The single collection every ThinkTank memory is written to and read from.
COLLECTION_NAME=thinktank-memory

# Embedding model. mcp-server-qdrant computes the vectors client-side via
# fastembed, so this model determines the collection's vector size (384) and
# distance metric (Cosine). Changing it after the collection exists means
# creating a new collection and re-storing the memories - never editing the
# model on a collection that already holds points.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
